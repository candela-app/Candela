# Backend origin. Native auth uses Authorization Bearer tokens, not cookies.
# Android emulator: http://10.0.2.2:3001
# iOS simulator: http://localhost:3001
# Physical device (same Wi-Fi as the computer): http://<your-LAN-IP>:3001
# Release APK / production: https://candela-backend.onrender.com
EXPO_PUBLIC_API_URL=https://candela-backend.onrender.com

# Public website opened from Sign in / Sign up. Swap this to the official domain when it is live.
EXPO_PUBLIC_WEBSITE_URL=https://candela-app-eta.vercel.app
