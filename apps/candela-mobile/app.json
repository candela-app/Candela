{
  "expo": {
    "name": "Kandela",
    "slug": "candela",
    "version": "0.1.5",
    "orientation": "default",
    "icon": "../../packages/shared/assets/app-icon-white.png",
    "scheme": "candela",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../../packages/shared/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.candela.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kandela does not record audio. Speech is used only to announce therapy targets.",
        "NSCameraUsageDescription": "Kandela uses the camera so you can pop pursuit targets by looking at them.",
        "NSPhotoLibraryUsageDescription": "Kandela uses your photo library so a parent can add family photos for Familiar Faces."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../../packages/shared/assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.candela.app",
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA", "android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Kandela uses the camera so you can pop pursuit targets by looking at them."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Kandela uses the camera so you can pop pursuit targets by looking at them.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kandela uses your photo library so a parent can add family photos for Familiar Faces."
        }
      ],
      "./plugins/with-android-architectures"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2a25b9ca-aac0-405e-9b75-a66272e692de"
      }
    },
    "owner": "candelaapp"
  }
}
