{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Pandroid.injected.build.abi=armeabi-v7a,arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://candela-backend-gbdz.onrender.com",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      }
    }
  }
}
