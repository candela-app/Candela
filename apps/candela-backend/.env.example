PORT=3001
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL — pooler (use for app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/candela?sslmode=require

# Neon PostgreSQL — direct (use for migrations / schema tools)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/candela?sslmode=require&channel_binding=require

# JWT — generate long random strings for production. Never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Admin seed — set real values in local .env / Render only. Never commit them.
ADMIN_1_EMAIL=admin@localhost
ADMIN_1_PASSWORD=change-me-admin-password
ADMIN_1_NAME=Admin
# ADMIN_2_EMAIL=
# ADMIN_2_PASSWORD=
# ADMIN_2_NAME=

# Set true once to update passwords for emails that already exist, then turn off.
ADMIN_SEED_OVERWRITE=false

# Mail — SMTP now. Switch MAIL_TRANSPORT=sendgrid later when a domain is ready.
# Use MAIL_TRANSPORT=log to skip sending and print confirm links in the backend console.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-smtp-app-password
MAIL_FROM=change-me-smtp-user
# Google Sign-In — client IDs from Google Cloud Console (OAuth clients).
GOOGLE_CLIENT_ID_WEB=change-me-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=change-me-google-android-client-id.apps.googleusercontent.com
# Optional. Needed only for some OAuth code flows, not ID-token verify.
# GOOGLE_CLIENT_SECRET=change-me-google-client-secret
