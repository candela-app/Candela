PORT=3001
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL — pooler (use for app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/candela?sslmode=require

# Neon PostgreSQL — direct (use for migrations / schema tools)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/candela?sslmode=require&channel_binding=require

# JWT — generate long random strings for production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# First admin (seeded once if no admin exists)
ADMIN_EMAIL=admin@candela.local
ADMIN_PASSWORD=changeme123
