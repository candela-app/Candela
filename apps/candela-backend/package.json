{
  "name": "@candela/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node ../../scripts/kill-port.js 3001 && node dist/main.js",
    "start:dev": "node ../../scripts/kill-port.js 3001 && ts-node-dev --respawn --transpile-only src/main.ts",
    "dev": "node ../../scripts/kill-port.js 3001 && ts-node-dev --respawn --transpile-only src/main.ts",
    "migration:run": "ts-node --transpile-only src/migrate.ts",
    "seed:admins": "ts-node --transpile-only src/seed-admins.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@types/node": "^20.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.17",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
