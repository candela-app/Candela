{
  "name": "candela-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:app",
    "dev:app": "npm run dev --workspace=@candela/app",
    "dev:backend": "npm run start:dev --workspace=@candela/backend",
    "build:shared": "npm run build --workspace=@candela/shared",
    "build": "npm run build --workspace=@candela/shared"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
