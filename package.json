{
  "name": "candela-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "start": "turbo start",
    "start:app": "npm run start --workspace=@candela/app",
    "start:dev": "turbo start:dev",
    "dev:app": "npm run dev --workspace=@candela/app",
    "dev:backend": "npm run start:dev --workspace=@candela/backend",
    "dev:mobile": "npm run start --workspace=@candela/mobile",
    "build:shared": "npm run build --workspace=@candela/shared"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^5.0.0"
  }
}
