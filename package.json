{
  "name": "candela-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/website/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=apps/website/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/website/backend",
    "build:shared": "npm run build --workspace=packages/shared",
    "build": "npm run build --workspace=packages/shared"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
